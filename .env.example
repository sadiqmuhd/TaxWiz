# Copy to .env and fill in. Never commit the real .env.

# --- Google Gemini: used for query embeddings and answer generation ------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides (defaults shown).
# The embedding model and dimension MUST match what the Pinecone namespace was
# built with. Vectors from different models are not comparable.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Changing this is safe: the code adapts the thinking directive to whatever
# model generation you name. gemini-3.7-flash is newer but currently returns
# 503 under free-tier load, and gemini-flash-latest resolves to it.
GEMINI_CHAT_MODEL=gemini-3.6-flash
# "low" or "high" on Gemini 3.x, or "off" to send no thinking directive.
GEMINI_THINKING_LEVEL=low
EMBEDDING_DIMENSIONS=1536

# --- Pinecone: the vector store holding the Nigerian tax corpus ----------------
PINECONE_API_KEY=
PINECONE_INDEX=taxwiz2
PINECONE_NAMESPACE=wiztax-gemini

# --- Retrieval tuning (optional) ----------------------------------------------
RAG_TOP_K=5
RAG_MIN_SCORE=0.25
LLM_MAX_OUTPUT_TOKENS=800

# --- Server (optional) --------------------------------------------------------
# Railway injects PORT automatically; only set this for local runs.
PORT=5000
LOG_LEVEL=INFO

