# Copy to .env and fill in. Never commit the real .env.

# --- OpenAI: used for query embeddings and answer generation -------------------
OPENAI_API_KEY=
# Optional overrides (defaults shown).
# The embedding model MUST match the one the Pinecone index was built with:
# text-embedding-3-small produces 1536-dimension vectors.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Pinecone: the vector store holding the Nigerian tax corpus ----------------
PINECONE_API_KEY=
PINECONE_INDEX=taxwiz2
PINECONE_NAMESPACE=wiztax

# --- Retrieval tuning (optional) ----------------------------------------------
RAG_TOP_K=5
RAG_MIN_SCORE=0.25
LLM_TIMEOUT_SECONDS=30

# --- Server (optional) --------------------------------------------------------
# Railway injects PORT automatically; only set this for local runs.
PORT=5000
LOG_LEVEL=INFO
